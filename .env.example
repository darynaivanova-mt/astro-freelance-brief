# Use these settings to collect a freelance project brief.
# Copy to .env and fill in your own credentials. Never commit a populated .env.
# See docs/email-setup.md for provider settings. MAIL_MODE=log lets you try the development app without sending.

APP_URL=http://localhost:3000 # The brief form must be opened from this origin for submissions to pass validation.
HOST=127.0.0.1 # Listener address; keep loopback for local use or configure it for your host.
PORT=3000 # Production HTTP port; keep APP_URL consistent with the address people actually use.
DB_PATH=.data/app.sqlite # Project briefs and the emails queued for the freelancer; SQLite file relative to the app directory. Preserve it across deployments.
ADMIN_PASSWORD= # Password for admin to review project briefs; generate a random value of at least 16 characters.
OWNER_EMAIL=owner@example.com # Freelancer inbox that should receive the full project brief; replace this sample address.
REVIEWER_EMAIL=reviewer@example.com # No reviewer recipient is needed for new project briefs; leave blank if preferred.
MAIL_MODE=sandbox # sandbox captures new project briefs; production sends them; log writes local previews in development.
MAIL_FROM=sender@example.com # Sender shown on new project briefs. Live sending requires your verified Mailtrap domain.
MAILTRAP_PRODUCTION_TOKEN= # Mailtrap sending token used only when new project briefs go through production mode.
MAILTRAP_SANDBOX_TOKEN= # Sandbox API token from your inbox integration settings; unrelated to the production token.
MAILTRAP_INBOX_ID= # Use the numeric ID from your Sandbox inbox integration to collect test new project briefs.
